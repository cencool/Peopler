{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Vagrant",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "/home/vagrant/web/peopler": "${workspaceFolder}"
            }
        },
        {
            "name": "Listen for Docker",
            "type": "php",
            "request": "launch",
            "port": 9005,
            "pathMappings": {
                "/app": "${workspaceFolder}"
            }
        },
        {
            "name": "Launch currently open script",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "port": 9000
        }
    ]
}